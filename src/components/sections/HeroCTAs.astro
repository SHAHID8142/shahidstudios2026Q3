---
/**
 * HeroCTAs — Primary and secondary calls to action for the Hero section.
 * Includes interactive hover states and glow effects.
 */
import { COPY } from '@constants/copy';
import PremiumCTA from '../ui/PremiumCTA.astro';
---

<div class="hero-cta-reveal relative z-10 flex flex-wrap items-center gap-4">
  <!-- Primary CTA -->
  <PremiumCTA href="/work" label={COPY.hero.cta} variant="primary" />

  <!-- Secondary CTA -->
  <PremiumCTA href="/contact" label={COPY.hero.ctaSecondary} variant="secondary" icon={false} />
</div>

<script>
  import gsap from 'gsap';

  document.addEventListener('astro:page-load', () => {
    // Reveal CTAs after typography
    gsap.fromTo(
      '.hero-cta-reveal',
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: 1, delay: 1.2, ease: 'expo.out' }
    );
  });
</script>
