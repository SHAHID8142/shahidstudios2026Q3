---
/**
 * Hero Section
 * Orchestrates the 3D WebGL background, typography, and CTAs.
 */
import HeroScene from '../3d/HeroScene';
import HeroTypography from './HeroTypography.astro';
import HeroCTAs from './HeroCTAs.astro';
---

<section id="hero" class="section-dark relative flex min-h-dvh items-center overflow-hidden pt-24">
  <!-- 3D Canvas Layer (React component with client directive) -->
  <HeroScene client:load />

  <!-- Content Layer -->
  <div class="pointer-events-auto relative z-10 container">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
      <div class="lg:col-span-8 xl:col-span-7">
        <HeroTypography />
        <HeroCTAs />
      </div>

      <!-- Optional right column for future balancing if needed -->
      <div class="relative hidden h-[400px] lg:col-span-4 lg:block xl:col-span-5">
        <!-- The 3D shapes will naturally populate this empty space -->
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div
    class="hero-scroll-indicator absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-2"
  >
    <span class="text-secondary text-[10px] font-medium tracking-[0.2em] uppercase">Scroll</span>
    <div
      class="from-secondary relative h-12 w-[1px] overflow-hidden bg-gradient-to-b to-transparent"
    >
      <div
        class="absolute top-0 left-0 h-1/2 w-full animate-[scroll-down_2s_ease-in-out_infinite] bg-[var(--color-accent)]"
      >
      </div>
    </div>
  </div>

  <style>
    @keyframes scroll-down {
      0% {
        transform: translateY(-100%);
        opacity: 0;
      }
      50% {
        opacity: 1;
      }
      100% {
        transform: translateY(200%);
        opacity: 0;
      }
    }
  </style>

  <script>
    import gsap from 'gsap';

    document.addEventListener('astro:page-load', () => {
      // Reveal scroll indicator last
      gsap.fromTo(
        '.hero-scroll-indicator',
        { opacity: 0 },
        { opacity: 1, duration: 1, delay: 2, ease: 'power2.inOut' }
      );
    });
  </script>
</section>
