---
/**
 * Footer — Site footer with social links, newsletter placeholder,
 * copyright, and legal links.
 */
import { COPY } from '@constants/copy';
import { SOCIAL_LINKS, CONTACT_INFO } from '@constants/social';
---

<footer class="section-dark border-t border-[var(--color-border-dark)]">
  <div class="container py-[var(--space-section)]">
    <!-- Top Grid: Brand + Links + Newsletter -->
    <div class="mb-16 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href="/" class="group mb-6 inline-flex items-center gap-3">
          <img
            src="/images/logos/logo-light-no-bg.svg"
            alt={`${COPY.site.name} logo`}
            width="36"
            height="36"
            class="h-9 w-9"
          />
          <span class="text-lg font-[var(--font-display)] font-semibold tracking-tight">
            {COPY.site.name}
          </span>
        </a>
        <p class="text-secondary max-w-xs text-sm leading-relaxed">
          {COPY.site.tagline}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="mb-6 text-sm font-semibold tracking-widest text-[var(--color-accent)] uppercase">
          Navigation
        </h4>
        <ul class="space-y-3" role="list">
          <li>
            <a
              href="/"
              class="text-secondary text-sm transition-colors hover:text-[var(--color-accent)]"
              style={`transition-duration: var(--duration-fast);`}>Home</a
            >
          </li>
          <li>
            <a
              href="/#about"
              class="text-secondary text-sm transition-colors hover:text-[var(--color-accent)]"
              style={`transition-duration: var(--duration-fast);`}>About</a
            >
          </li>
          <li>
            <a
              href="/#services"
              class="text-secondary text-sm transition-colors hover:text-[var(--color-accent)]"
              style={`transition-duration: var(--duration-fast);`}>Services</a
            >
          </li>
          <li>
            <a
              href="/work"
              class="text-secondary text-sm transition-colors hover:text-[var(--color-accent)]"
              style={`transition-duration: var(--duration-fast);`}>Work</a
            >
          </li>
          <li>
            <a
              href="/blog"
              class="text-secondary text-sm transition-colors hover:text-[var(--color-accent)]"
              style={`transition-duration: var(--duration-fast);`}>Blog</a
            >
          </li>
          <li>
            <a
              href="/contact"
              class="text-secondary text-sm transition-colors hover:text-[var(--color-accent)]"
              style={`transition-duration: var(--duration-fast);`}>Contact</a
            >
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="mb-6 text-sm font-semibold tracking-widest text-[var(--color-accent)] uppercase">
          Contact
        </h4>
        <ul class="space-y-3" role="list">
          <li>
            <a
              href={`mailto:${CONTACT_INFO.email}`}
              class="text-secondary text-sm transition-colors hover:text-[var(--color-accent)]"
              style={`transition-duration: var(--duration-fast);`}
            >
              {CONTACT_INFO.email}
            </a>
          </li>
          <li>
            <a
              href={CONTACT_INFO.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="text-secondary inline-flex items-center gap-2 text-sm transition-colors hover:text-[var(--color-accent)]"
              style={`transition-duration: var(--duration-fast);`}
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                ></path>
              </svg>
              WhatsApp
            </a>
          </li>
          <li class="text-secondary text-sm">
            {CONTACT_INFO.location}
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h4 class="mb-6 text-sm font-semibold tracking-widest text-[var(--color-accent)] uppercase">
          {COPY.footer.newsletter.heading}
        </h4>
        <p class="text-secondary mb-4 text-sm">
          {COPY.footer.newsletter.subheading}
        </p>
        <form class="flex gap-2" data-newsletter-form>
          <input
            type="email"
            placeholder={COPY.footer.newsletter.placeholder}
            required
            class="flex-1 rounded-[var(--radius-md)] border border-[var(--color-border-dark)] bg-[var(--color-bg-dark-surface)] px-4 py-2.5 text-sm text-[var(--color-text-primary-on-dark)] transition-colors placeholder:text-[var(--color-text-muted-on-dark)] focus:border-[var(--color-accent)] focus:outline-none"
            style={`transition-duration: var(--duration-fast);`}
            aria-label="Email for newsletter"
          />
          <button
            type="submit"
            class="rounded-[var(--radius-md)] bg-[var(--color-accent)] px-4 py-2.5 text-sm font-semibold text-[var(--color-text-on-accent)] transition-all hover:shadow-[var(--shadow-accent-glow)] active:scale-95"
            style={`transition-duration: var(--duration-normal); transition-timing-function: var(--ease-out-expo);`}
          >
            {COPY.footer.newsletter.submit}
          </button>
        </form>
      </div>
    </div>

    <!-- Social Links -->
    <div class="mb-12 flex flex-wrap items-center gap-4">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.ariaLabel}
            class="flex h-10 w-10 items-center justify-center rounded-[var(--radius-full)] border border-[var(--color-border-dark)] text-[var(--color-text-secondary-on-dark)] transition-all hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
            style={`transition-duration: var(--duration-normal); transition-timing-function: var(--ease-out-expo);`}
          >
            <span class="text-xs font-semibold uppercase">{link.platform.slice(0, 2)}</span>
          </a>
        ))
      }
    </div>

    <!-- Bottom Bar -->
    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-[var(--color-border-dark)] pt-8 sm:flex-row"
    >
      <p class="text-muted text-xs">
        {COPY.footer.copyright}
      </p>
      <div class="flex items-center gap-6">
        <a
          href="/privacy"
          class="text-muted text-xs transition-colors hover:text-[var(--color-accent)]"
          style={`transition-duration: var(--duration-fast);`}
        >
          Privacy Policy
        </a>
        <a
          href="/terms"
          class="text-muted text-xs transition-colors hover:text-[var(--color-accent)]"
          style={`transition-duration: var(--duration-fast);`}
        >
          Terms of Service
        </a>
      </div>
    </div>
  </div>
</footer>
